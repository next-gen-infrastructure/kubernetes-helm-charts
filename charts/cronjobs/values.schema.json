{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "affinity": {
      "required": [],
      "type": "object"
    },
    "configMap": {
      "properties": {
        "data": {
          "required": [],
          "type": "object"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [],
      "type": "object"
    },
    "cronjobs": {
      "additionalProperties": {
        "properties": {
          "activeDeadlineSeconds": {
            "description": "Hard cap on the job's runtime in seconds; the pods are terminated past it",
            "minimum": 1,
            "type": "integer"
          },
          "annotations": {
            "description": "CronJob annotations",
            "type": [
              "object",
              "null"
            ]
          },
          "args": {
            "description": "Container args",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "backoffLimit": {
            "default": 6,
            "description": "Retries before the job is considered failed. Only honoured when global.environment is prod, otherwise 0",
            "type": "integer"
          },
          "command": {
            "description": "Container command",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "concurrencyPolicy": {
            "default": "Forbid",
            "description": "Only honoured when global.environment is prod, otherwise Forbid",
            "enum": [
              "Allow",
              "Forbid",
              "Replace"
            ],
            "type": "string"
          },
          "env": {
            "description": "Job-level env: values and vaultSecret",
            "type": "object"
          },
          "failedJobsHistoryLimit": {
            "default": 3,
            "description": "Failed jobs to keep",
            "type": "integer"
          },
          "resources": {
            "description": "Container resource requests and limits",
            "type": "object"
          },
          "schedule": {
            "description": "Cron schedule",
            "type": "string"
          },
          "securityContext": {
            "description": "Container security context, merged over the chart-level one",
            "type": "object"
          },
          "startingDeadlineSeconds": {
            "description": "Deadline in seconds for starting a run that missed its schedule",
            "type": "integer"
          },
          "successfulJobsHistoryLimit": {
            "default": 1,
            "description": "Successful jobs to keep",
            "type": "integer"
          },
          "suspend": {
            "default": false,
            "description": "Suspend subsequent runs",
            "type": "boolean"
          },
          "timeZone": {
            "description": "IANA time zone of the schedule",
            "type": "string"
          },
          "ttlSecondsAfterFinished": {
            "description": "Seconds after which a finished job and its pods are deleted",
            "type": "integer"
          }
        },
        "required": [
          "schedule"
        ],
        "type": "object"
      },
      "default": {},
      "description": "Cronjobs configuration, keyed by job name",
      "required": [],
      "type": "object"
    },
    "env": {
      "properties": {
        "configmap": {
          "required": [],
          "type": "object"
        },
        "refs": {
          "required": [],
          "type": "object"
        },
        "secret": {
          "required": [],
          "type": "object"
        },
        "values": {
          "required": [],
          "type": "object"
        },
        "vaultSecret": {
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "envFrom": {
      "items": {
        "required": []
      },
      "type": "array"
    },
    "exampleValue": {
      "default": "common-chart",
      "type": "string"
    },
    "fullnameOverride": {
      "default": "",
      "type": "string"
    },
    "global": {
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "environment": {
          "default": "dev",
          "type": "string"
        },
        "image": {
          "properties": {
            "pullPolicy": {
              "default": "IfNotPresent",
              "type": "string"
            },
            "pullSecrets": {
              "items": {
                "required": []
              },
              "type": "array"
            },
            "registry": {
              "default": "",
              "type": "string"
            },
            "repository": {
              "default": "",
              "type": "string"
            },
            "tag": {
              "default": "latest",
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "project": {
          "default": "",
          "type": "string"
        },
        "secretStore": {
          "default": "vault",
          "type": "string"
        },
        "serviceName": {
          "default": "",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "hostPid": {
      "default": false,
      "type": "boolean"
    },
    "nameOverride": {
      "default": "",
      "type": "string"
    },
    "networkPolicy": {
      "properties": {
        "cilium": {
          "default": true,
          "type": "boolean"
        },
        "egress": {
          "properties": {
            "allowDNS": {
              "default": true,
              "type": "boolean"
            },
            "fqdns": {
              "items": {
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "extraEgress": {
          "items": {
            "required": []
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeAffinityPreset": {
      "properties": {
        "key": {
          "default": "",
          "type": "string"
        },
        "type": {
          "default": "",
          "type": "string"
        },
        "values": {
          "items": {
            "required": []
          },
          "type": "array"
        }
      },
      "required": [],
      "type": "object"
    },
    "nodeSelector": {
      "required": [],
      "type": "object"
    },
    "podAffinity": {
      "properties": {
        "preset": {
          "default": "disabled",
          "type": "string"
        },
        "topologyKey": {
          "default": "kubernetes.io/hostname",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podAntiAffinity": {
      "properties": {
        "preset": {
          "default": "soft",
          "type": "string"
        },
        "topologyKey": {
          "default": "kubernetes.io/hostname",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "podSecurityContext": {
      "properties": {
        "fsGroup": {
          "default": 65534,
          "type": "integer"
        },
        "runAsGroup": {
          "default": 65534,
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": true,
          "type": "boolean"
        },
        "runAsUser": {
          "default": 1000,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "resources": {
      "properties": {
        "limits": {
          "required": [],
          "type": "object"
        },
        "requests": {
          "required": [],
          "type": "object"
        }
      },
      "required": [],
      "type": "object"
    },
    "resourcesPreset": {
      "default": "none",
      "type": "string"
    },
    "securityContext": {
      "properties": {
        "allowPrivilegeEscalation": {
          "default": false,
          "type": "boolean"
        },
        "capabilities": {
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "type": "array"
            }
          },
          "required": [],
          "type": "object"
        },
        "readOnlyRootFilesystem": {
          "default": true,
          "type": "boolean"
        },
        "runAsGroup": {
          "default": 65534,
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": true,
          "type": "boolean"
        },
        "runAsUser": {
          "default": 1000,
          "type": "integer"
        }
      },
      "required": [],
      "type": "object"
    },
    "serviceAccount": {
      "properties": {
        "annotations": {
          "required": [],
          "type": "object"
        },
        "create": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "tolerations": {
      "items": {
        "required": []
      },
      "type": "array"
    },
    "volumes": {
      "required": [],
      "type": "object"
    }
  },
  "required": [],
  "type": "object"
}