{
    "title": "Chart Values",
    "type": "object",
    "properties": {
        "global": {
            "type": "object",
            "properties": {
                "project": {
                    "type": "string",
                    "description": "The project of the service",
                    "default": ""
                },
                "serviceName": {
                    "type": "string",
                    "description": "Name of the service. Affects public DNS.",
                    "default": ""
                },
                "secretStore": {
                    "type": "string",
                    "description": "Name of the ClusterSecretStore used by ExternalSecrets for Vault secrets",
                    "default": "vault"
                },
                "environment": {
                    "type": "string",
                    "description": "Name of the environment, one of \"dev\", \"stage\", \"prod\".",
                    "default": "dev"
                },
                "image": {
                    "type": "object",
                    "properties": {
                        "registry": {
                            "type": "string",
                            "description": "Image registry, E.g. 1234567890.dkr.ecr.eu-central-1.amazonaws.com",
                            "default": ""
                        },
                        "repository": {
                            "type": "string",
                            "description": "Image repository, E.g. k8s/example-service",
                            "default": ""
                        },
                        "tag": {
                            "type": "string",
                            "description": "Tag of the image",
                            "default": "latest"
                        },
                        "pullPolicy": {
                            "type": "string",
                            "description": "The default pull policy is IfNotPresent which causes",
                            "default": "IfNotPresent"
                        },
                        "pullSecrets": {
                            "type": "array",
                            "description": "Optionally specify an array of imagePullSecrets.",
                            "default": [],
                            "items": {}
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "By default, name uses '{{ .Chart.Name }}'.",
            "default": ""
        },
        "fullnameOverride": {
            "type": "string",
            "description": "By default, fullname uses '{{ .Release.Name }}-{{ .Chart.Name }}'.",
            "default": ""
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context",
            "default": {}
        },
        "securityContext": {
            "type": "object",
            "description": "Security context for the container",
            "default": {}
        },
        "hostPid": {
            "type": "boolean",
            "description": "Use the host’s pid namespace",
            "default": false
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node labels for pod assignment",
            "default": {}
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for pod assignment",
            "default": [],
            "items": {}
        },
        "podAffinity": {
            "type": "object",
            "properties": {
                "preset": {
                    "type": "string",
                    "description": "Preset type: soft (preferred), hard (required) or disabled",
                    "default": "disabled"
                },
                "topologyKey": {
                    "type": "string",
                    "description": "Topology key of the affinity term",
                    "default": "kubernetes.io/hostname"
                }
            }
        },
        "podAntiAffinity": {
            "type": "object",
            "properties": {
                "preset": {
                    "type": "string",
                    "description": "Preset type: soft (preferred), hard (required) or disabled",
                    "default": "soft"
                },
                "topologyKey": {
                    "type": "string",
                    "description": "Topology key of the affinity term",
                    "default": "kubernetes.io/hostname"
                }
            }
        },
        "nodeAffinityPreset": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Node affinity preset type. Ignored if `affinity` is set. Allowed values: `soft` or `hard`",
                    "default": ""
                },
                "key": {
                    "type": "string",
                    "description": "Node label key to match Ignored if `affinity` is set.",
                    "default": ""
                },
                "values": {
                    "type": "array",
                    "description": "Node label values to match. Ignored if `affinity` is set.",
                    "default": [],
                    "items": {}
                }
            }
        },
        "affinity": {
            "type": "object",
            "description": "Affinity for pod assignment",
            "default": {}
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "create": {
                    "type": "boolean",
                    "description": "Specifies whether a service account should be created",
                    "default": false
                },
                "annotations": {
                    "type": "object",
                    "description": "Annotations to add to the service account",
                    "default": {}
                },
                "name": {
                    "type": "string",
                    "description": "The name of the service account to use.",
                    "default": ""
                }
            }
        },
        "env": {
            "type": "object",
            "properties": {
                "values": {
                    "type": "object",
                    "description": "generic Environment variables that get added to the container",
                    "default": {}
                },
                "refs": {
                    "type": "object",
                    "description": "Environment variables as references to the pod",
                    "default": {}
                },
                "configmap": {
                    "type": "object",
                    "description": "Environment variables that get added to the container from ConfigMap",
                    "default": {}
                },
                "secret": {
                    "type": "object",
                    "description": "Kubernetes secrets that get added to the container",
                    "default": {}
                },
                "vaultSecret": {
                    "type": "object",
                    "description": "Kubernetes secrets that get added to the container from Hashicorp Vault",
                    "default": {}
                }
            }
        },
        "envFrom": {
            "type": "array",
            "description": "Sources of environment variables for the container (configMapRef / secretRef). Supports helm templates",
            "default": [],
            "items": {}
        },
        "configMap": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Create a ConfigMap from configMap.data and load it into the container via envFrom",
                    "default": false
                },
                "data": {
                    "type": "object",
                    "description": "Key-value pairs of the ConfigMap",
                    "default": {}
                }
            }
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "description": "The resources limits for the container",
                    "default": {}
                },
                "requests": {
                    "type": "object",
                    "description": "The requests resources for the container",
                    "default": {}
                }
            }
        },
        "volumes": {
            "type": "object",
            "description": "Container volumes configuration",
            "default": {}
        }
    }
}